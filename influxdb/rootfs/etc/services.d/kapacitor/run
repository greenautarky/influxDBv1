#!/command/with-contenv bashio
# ==============================================================================
# Home Assistant Community Add-on: InfluxDB
# Runs the Kapacitor Server
# ==============================================================================
declare secret

# Kapacitor is the alerting/processing companion. No GA component defines a
# task in it, so it is optional and defaults to off — see the note in
# services.d/chronograf/run for why `s6-svc -O` is needed here.
if ! bashio::config.true 'kapacitor'; then
    bashio::log.info "Kapacitor is disabled by add-on configuration; not starting it."
    exec s6-svc -O /run/service/kapacitor
fi

# Wait for InfluxDB to become available
s6-svwait -u -t 5000 /run/service//influxdb

secret=$(</data/secret)

# Wait for InfluxDB...
bashio::log.info "Kapacitor is waiting until InfluxDB is available..."
for i in {1800..0}; do
    if influx \
        -execute "SHOW DATABASES" \
        -username "kapacitor" \
        -password "${secret}" \
        > /dev/null 2>&1; then
        break;
    fi
    sleep 5
done

if [[ "$i" = 0 ]]; then
    bashio::log.warning "Kapacitor is done waiting. Starting anyway..."
fi

bashio::log.info 'Starting the Kapacitor'

# Run Kapacitor
exec kapacitord
