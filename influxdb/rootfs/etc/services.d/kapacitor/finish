#!/command/with-contenv bashio
# ==============================================================================
# Home Assistant Community Add-on: InfluxDB
# Take down the S6 supervision tree when Kapacitor fails
# ==============================================================================
# A service switched off by configuration exits cleanly on purpose. Without
# this guard the run script's early exit is indistinguishable from a crash and
# the add-on would halt itself on every start.
if ! bashio::config.true 'kapacitor'; then
  exit 0
fi

if [[ "${1}" -ne 0 ]] && [[ "${1}" -ne 256 ]]; then
  bashio::log.warning "Kapacitor crashed, halting add-on"
  /run/s6/basedir/bin/halt
fi

bashio::log.info "Kapacitor stopped, restarting..."
